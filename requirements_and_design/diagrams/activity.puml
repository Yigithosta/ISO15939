@startuml Activity_Diagram
!theme plain
skinparam backgroundColor #FAFAFA
skinparam activity {
  BackgroundColor #EEF4FF
  BorderColor #2166AC
  FontSize 13
  DiamondBackgroundColor #FFF8E1
  DiamondBorderColor #E65100
}
skinparam ArrowColor #2166AC
skinparam StartColor #2166AC
skinparam EndColor #1B5E20

title ISO 15939 Measurement Process Simulator — Activity Diagram

start

:Launch Application;
:Display Step 1 — Profile;

repeat
  :User enters Username, School, Session Name;
  if (All fields filled?) then (yes)
    :Save UserProfile to Session;
  else (no)
    :Show warning dialog\n(field-specific message);
  endif
repeat while (All fields filled?) is (no)
->yes;

:Display Step 2 — Define;
:User selects Quality Type\n(Product / Process);
:User selects Mode\n(Health / Education);
:Load scenarios for selected mode;
:User selects a Scenario;
:Save QualityType, Mode, Scenario to Session;

:Display Step 3 — Plan;
:Fetch Dimensions & Metrics\nfrom ScenarioRepository;
:Render read-only table\n(Metric, Coefficient, Direction, Range, Unit);

:Display Step 4 — Collect;
:Load hard-coded raw values\nfor selected scenario;
fork
  :Display metric raw values in table;
fork again
  :Calculate score per metric\nusing formula (1–5, rounded 0.5);
end fork
:Render Collect table;

:Display Step 5 — Analyse;

fork
  :5a — Calculate weighted avg per dimension\ndimensionScore = Σ(score×coeff)/Σ(coeff);
  :Render JProgressBar for each dimension;
fork again
  :5b — Draw Radar Chart\n(Graphics2D, spider polygon);
fork again
  :5c — Identify dimension with lowest score;
  :Compute gap = 5.0 − lowestScore;
  :Assign quality level\n(Excellent/Good/Needs Improvement/Poor);
  :Display gap analysis box;
end fork

if (User clicks New Session?) then (yes)
  :Reset all session data;
  :Return to Step 1 — Profile;
else (no / close)
  :End Session;
endif

stop
@enduml
